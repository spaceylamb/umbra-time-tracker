    "Week": {
      "description": "GET /api/week/{week} and POST /api/week/{week}/goals. Day payloads are fetched per day; this carries only what exists per week. done: days whose attribution is current for these priorities — any other day is unasked, not zero. totals: minutes per priority index (1-based, as a string key); a stretch credited to two priorities counts fully for both. judging: a judgement started by saving these priorities is still running.",
      "type": "object",
      "required": [
        "week",
        "days",
        "goals",
        "gdig",
        "model",
        "attrib",
        "totals",
        "done",
        "priorities",
        "judging",
        "judge_failed",
        "judge_error"
      ],
      "additionalProperties": false,
      "properties": {
        "week": {
          "type": "string",
          "pattern": "^\\d{4}-W\\d{2}$"
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IsoDate"
          },
          "minItems": 7,
          "maxItems": 7
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "gdig": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "attrib": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "a",
                "b",
                "g",
                "why"
              ],
              "additionalProperties": false,
              "properties": {
                "a": {
                  "type": "integer"
                },
                "b": {
                  "type": "integer"
                },
                "g": {
                  "type": "integer"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "done": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IsoDate"
          }
        },
        "priorities": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "target",
              "unit",
              "minutes",
              "sessions",
              "session_days"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "target": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "enum": [
                  "hours",
                  "sessions",
                  null
                ]
              },
              "minutes": {
                "type": "integer"
              },
              "sessions": {
                "type": "integer"
              },
              "session_days": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/IsoDate"
                }
              }
            }
          }
        },
        "judging": {
          "type": "boolean",
          "description": "This week's days are being judged against its priorities right now — started by saving new wording. Poll until false; done then says which days are current."
        },
        "judge_failed": {
          "type": "boolean",
          "description": "The judging run started by the last save ended in failure — most often no model key. The days it did not reach stay unjudged and are asked again on the next run."
        },
        "judge_error": {
          "type": [
            "string",
            "null"
          ],
          "description": "When judge_failed: the run's own last warning, in one line — why it failed, not a guess."
        }
      }
    },
