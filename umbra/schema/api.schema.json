          "type": [
            "string",
            "null"
          ]
        },
        "send_only": {
          "description": "what this plugin makes is only ever sent (an alert, a monthly list): on means sending, and there is no second switch",
          "type": "boolean"
        },
        "destination": {
          "description": "where the named sink actually sends, in words (\"Butler (your inbox)\", \"the command …\", \"the webhook at host\"); null with no sink, or one that does not resolve",
          "type": [
            "string",
            "null"
          ]
        },
        "blocked": {
          "type": [
            "string",
            "null"
          ],
